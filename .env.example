# MealWorks — environment template
# Copy to .env and fill in values. Never commit .env.

# AI (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Application
AUTH_SECRET=generate-a-long-random-string
APP_URL=http://localhost:3000
DATABASE_PATH=./data/mealworks.db

# Seeded cafe admin (local development only)
ADMIN_EMAIL=cafe.admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Cafe Admin

# Optional: morning digest email (SMTP)
# iCloud: smtp.mail.me.com, port 587, SMTP_SECURE=false, app-specific password
# Gmail:  smtp.gmail.com, port 465, SMTP_SECURE=true, app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MealWorks <noreply@example.com>

# Optional: protect POST /api/admin/digests/tick
# CRON_SECRET=

# Optional: set to 0 to disable in-process digest scheduler
# DIGEST_SCHEDULER=1
