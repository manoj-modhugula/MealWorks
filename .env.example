# MealWorks — environment template
# Copy to .env and fill in values. Never commit .env.

# AI (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Application
AUTH_SECRET=generate-a-long-random-string
APP_URL=http://localhost:3000
DATABASE_PATH=./data/mealworks.db

# Seeded cafe admin (local development only)
ADMIN_EMAIL=cafe.admin@example.com
ADMIN_PASSWORD=change-me-in-production
ADMIN_NAME=Cafe Admin
# Set to 1 to force-reset the seeded admin password on boot (never needed in prod)
# ADMIN_RESET_ON_BOOT=0

# Email (required for signup OTP, password reset, and step-up codes)
# iCloud: smtp.mail.me.com, port 587, SMTP_SECURE=false, app-specific password
# Gmail:  smtp.gmail.com, port 465, SMTP_SECURE=true, app password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MealWorks <noreply@example.com>

# Optional: only these domains may register or OAuth in (comma-separated)
# ALLOWED_EMAIL_DOMAINS=office.com

# Optional OAuth (buttons appear only when set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_ID=
# APPLE_SECRET=

# Required in production: protect POST /api/admin/digests/tick
# CRON_SECRET=

# Optional: set to 0 to disable in-process digest scheduler
# DIGEST_SCHEDULER=1
